{
  "manifest_version": 3,
  "name": "Google Scholar 论文抓取器",
  "version": "1.0.0",
  "description": "从Google Scholar个人主页抓取论文标题、链接、摘要和发表日期",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://scholar.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://scholar.google.com/citations*"],
      "js": ["content.js"]
    }
  ]
}
